# Environment Mode: development or production
ENVIRONMENT=development

# Application Security Keys (Change in production!)
SECRET_KEY=change-this-to-a-secure-random-32-byte-secret-key-in-production!
ENCRYPTION_KEY=change-this-to-a-valid-base64-32-byte-fernet-key!

# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME

# Redis Connection Settings
REDIS_URL=redis://HOST:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# GitHub OAuth Credentials & Scopes
GITHUB_CLIENT_ID=your_github_oauth_client_id_here
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret_here
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback
GITHUB_OAUTH_SCOPES=repo,read:user

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Worker Capabilities (Comma-separated: general, friction, github)
WORKER_CAPABILITIES=general,friction,github

# Frontend Environment API Base URL
VITE_API_URL=http://localhost:8000
